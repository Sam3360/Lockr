{
  "name": "@sam3360/lockr",
  "version": "1.0.0",
  "description": "A local-first encrypted command-line password manager",
  "type": "module",
  "bin": {
    "lockr": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/tests/crypto.test.js .test-dist/tests/master-password.test.js .test-dist/tests/vault.test.js",
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check && npm test && npm run build"
  },
  "keywords": [
    "password-manager",
    "cli",
    "encryption",
    "local-first"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sam3360/Lockr.git"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.1.0",
    "@stablelib/xchacha20poly1305": "^2.0.1",
    "argon2": "^0.44.0",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.25.12": true
  }
}
